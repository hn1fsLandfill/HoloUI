<?xml version="1.0" encoding="utf-8"?>
<eu.hn1f.holoui.widgets.PanelView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#c81f1f1f"
        android:id="@+id/notification_shade">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/black"
            android:orientation="horizontal">

            <eu.hn1f.holoui.widgets.Clock
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textSize="36sp" />
        </LinearLayout>
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(DEBUG) close shade"
            android:id="@+id/debug_shade"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:text="holoui testing" />
    </LinearLayout>

    <View
        android:id="@+id/handle"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@drawable/status_bar_close" />
</eu.hn1f.holoui.widgets.PanelView>