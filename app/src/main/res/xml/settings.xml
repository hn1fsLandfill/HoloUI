<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="main">
        <ListPreference
            android:key="era"
            android:title="Era"
            android:entries="@array/eras"
            android:entryValues="@array/eras_value"/>
        <SwitchPreference
            android:key="use_nav"
            android:title="Use built-in navigation bar"
            android:summary="(may break built-in launcher)"/>
        <PreferenceScreen android:title="About HoloUI">
            <PreferenceCategory>
                <Preference
                    android:summary="Xposed"
                    android:title="Injection method" />
                <Preference
                    android:summary="alpha"
                    android:title="HoloUI version" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>
</PreferenceScreen>